# Verid-iq — Environment Variables
# Copy this file to .env for local development.
# On Railway, set these as environment variables in the project dashboard.
# NEVER commit a .env file with real values to git.

# ── Required ────────────────────────────────────────────────────────────────

# A long random string used to sign JWT tokens and encrypt sensitive DB values.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

# Your Anthropic API key — get it from https://console.anthropic.com
# This can also be set via the admin setup wizard (/setup) after first boot.
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ─────────────────────────────────────────────────────────────────

# Local SQLite (default — no change needed for local dev):
# DATABASE_URL=sqlite+aiosqlite:///./veridiq.db

# Railway PostgreSQL (injected automatically by Railway — do not set manually):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Optional ─────────────────────────────────────────────────────────────────

# Set to "production" on Railway; controls CORS, API docs visibility, log level.
ENVIRONMENT=development

# Email (SMTP) — needed for password reset and verification emails.
# Leave blank to disable email (tokens shown in logs instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@networklogic.uk

# LinkedIn OAuth — needed for LinkedIn SSO login.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://veridiq.networklogic.uk/auth/linkedin/callback

# Public base URL — used in emails and OAuth callbacks.
BASE_URL=https://veridiq.networklogic.uk
